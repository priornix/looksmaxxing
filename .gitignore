# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtualenvs ------------------------------------------------------------
.venv/
venv/
env/
.python-version

# --- Secrets ----------------------------------------------------------------
# ANTHROPIC_API_KEY lives here in local dev; never commit it.
.env
.env.*
!.env.example
*.key

# --- Pipeline run artifacts -------------------------------------------------
# The claim graph is regenerable from `cli.py run`; the DB is state, not source.
runs/
*.db
*.db-journal
*.sqlite3

# --- Generated site data ----------------------------------------------------
# Regenerated by export_site.py on every deploy; uncomment to commit a snapshot
# if you would rather Pages serve a checked-in bundle than build in CI.
docs/data.js

# --- Caches / tooling -------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store

# --- Scratch ----------------------------------------------------------------
scratch/
*.log
